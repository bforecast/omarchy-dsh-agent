  // Local DeepSeek Harness (DSH) -- AI agent entry in the "Default Agent"
  // picker, wired to ~/.local/bin/omarchy-default-agent, which understands
  // `dsh`. Launching DSH uses the application row with the real icon
  // (dsh.desktop, Icon=dsh) or Super+Shift+Ctrl+A.
  "setup.default.agent.dsh": {"icon":"󰚩","label":"DSH","description":"DeepSeek Harness (local web agent)","checked":"[[ \"$(omarchy-default-agent)\" == \"dsh\" ]]","action":"omarchy-default-agent dsh"}
